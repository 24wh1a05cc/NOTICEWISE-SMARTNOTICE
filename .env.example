# NoticeWise – SmartNotice: Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
#
# Usage: flutter_dotenv loads this file at app startup from flutter assets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (optional if using flutterfire-generated firebase_options.dart) ─
# These are only needed if you are constructing FirebaseOptions manually
# instead of using `flutterfire configure`.
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_APP_ID=your_app_id_here
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# ── AI Service (Spec 7 — Smart Features) ────────────────────────────────────
# Backend endpoint that proxies AI requests (never call AI APIs from the app).
AI_SERVICE_BASE_URL=https://your-backend.example.com/api

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to true to enable AI features (requires AI_SERVICE_BASE_URL to be set).
ENABLE_AI_FEATURES=false
